{
  "name": "ardex-pro-demo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-baseline.mjs",
    "demo": "node scripts/start-demo.mjs",
    "demo:preview": "node scripts/start-demo.mjs --preview",
    "admin": "vite --host 127.0.0.1 --port 5175 --strictPort --open /admin.html",
    "qr:stickers": "node scripts/qr-stickers.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
